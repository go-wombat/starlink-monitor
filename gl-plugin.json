{
  "$schema": "https://raw.githubusercontent.com/go-wombat/gl-sdk4-plugin-kit/main/schema/gl-plugin.schema.json",
  "schemaVersion": 1,
  "id": "starlink-monitor",
  "profile": "full-stack",
  "views": [
    {
